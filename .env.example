# ============================================================
# G Shop Bot · .env 配置模板
# 用法：cp .env.example .env 后按实际填写
# 注意：冷钱包地址 / 链 API Key / 渠道开关 / 限额【不在此文件】，
#       全部在管理面板「💳 支付设置」在线配置（存数据库 settings 表）
# ============================================================

# Telegram Bot Token（必填，从 @BotFather 获取；更换后必须重启）
BOT_TOKEN=在此填入你的BotToken

# 主管理员 Telegram 数字 ID（必填，多个管理员在管理面板里加）
# 查自己 ID：给 @userinfobot 发一条消息
ADMIN_ID=在此填入你的TG数字ID

# ---------- OkPay 支付通道（商户号+密钥，不用可留空） ----------
OKPAY_ID=
OKPAY_TOKEN=

# ---------- KKPay 支付通道（不用可留空） ----------
KKPAY_ID=
KKPAY_TOKEN=

# ---------- 健康检查端口（遗留键，代码未读取，保留无害） ----------
HEALTH_PORT=8080
